# Example environment variables for local development
# Copy to .env and fill in your values (NEVER commit .env)

# Automation Hub credentials (for ansible-builder)
ANSIBLE_GALAXY_SERVER_AUTOMATION_HUB_URL=https://console.redhat.com/api/automation-hub/content/published/
ANSIBLE_GALAXY_SERVER_AUTOMATION_HUB_TOKEN=your_automation_hub_token_here

# Container registry (Quay)
REGISTRY_URL=quay.io
REGISTRY_USERNAME=jhardy+bob
REGISTRY_PASSWORD=your_robot_account_password_here
IMAGE_NAME=quay.io/jhardy/poc-plac
IMAGE_TAG=latest

# AAP Gateway (for testing)
AAP_GATEWAY_URL=https://your-aap-gateway.example.com
AAP_TOKEN=your_gateway_admin_token_here
# OR use username/password for dev:
# AAP_USERNAME=admin
# AAP_PASSWORD=your_password

# Kubernetes (for CR mode testing)
CR_NAMESPACE=aap-lifecycle-poc
CR_NAME=example-platform
